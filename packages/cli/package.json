{
  "name": "ultimatehuman",
  "version": "0.1.0",
  "private": false,
  "files": ["dist", "LICENSE", "THIRD_PARTY_NOTICES.txt"],
  "engines": { "node": ">=22.13.0" },
  "os": ["darwin", "linux"],
  "type": "module",
  "description": "AI investigates. You decide. Turn production signals and repository code into evidence-backed engineering reviews, using Claude Code.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincent38wargnier/ultimatehuman.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vincent38wargnier/ultimatehuman#readme",
  "bugs": { "url": "https://github.com/vincent38wargnier/ultimatehuman/issues" },
  "keywords": ["claude-code", "ai", "engineering", "bug-detection", "code-review", "posthog", "datadog", "self-hosted"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "bin": {
    "ultimatehuman": "./dist/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@ultimatehuman/core": "workspace:*",
    "@ultimatehuman/sdk": "workspace:*",
    "@ultimatehuman/plugin-posthog": "workspace:*",
    "@ultimatehuman/plugin-sentry": "workspace:*",
    "@ultimatehuman/plugin-datadog": "workspace:*",
    "@ultimatehuman/plugin-github": "workspace:*",
    "@ultimatehuman/plugin-telegram": "workspace:*"
  }
}
