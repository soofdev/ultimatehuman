{
  "name": "ultimatehuman",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted bug radar: reads your trackers, root-causes real product problems, files evidence-rich GitHub issues. The AI can look, never touch.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @ultimatehuman/dashboard build && node scripts/build.mjs",
    "build:cli": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.7.0"
  }
}
