// Copy to ~/.ultimatehuman/config.json5. Secrets are ${ENV_VAR} references only.
{
  version: 1,
  auth: {
    sources: [
      { id: "sub", kind: "claude_login" },
      // { id: "key", kind: "anthropic_api_key", apiKey: "${ANTHROPIC_API_KEY}", dailyCapUsd: 5 },
    ],
  },
  governor: { humanReservePct: 30 },
  // Pipelines: each one is data you own (docs/pipelines.md). `template` copies a suggestion in;
  // every field can be overridden, and a file without `pipelines` (an old `radar` block) migrates to one bug-radar.
  pipelines: [
    { id: "bug-radar", template: "bug-radar" },
    // { id: "security-check", template: "security-check", schedule: "every 12 hours" },
    // { id: "api-errors", name: "API errors only", sources: ["datadog"], signalTypes: ["error_group", "log_pattern"], schedule: "0 */4 * * *" },
  ],
  // Local checkouts the agents read. Each keeps its own git/GitHub auth: no token here.
  repos: [
    { name: "web", path: "/home/me/code/web", testUrl: "https://staging.example.com" },
    // { name: "api", path: "/home/me/code/api", notes: "Python backend" },
  ],
  plugins: {
    sentry: { credentials: { authToken: "${SENTRY_AUTH_TOKEN}" } },
    // Optional: issue previews only (dry run). The pipeline keeps its own tickets without it.
    // github: { credentials: { token: "${GITHUB_TOKEN}", repo: "owner/repo" } },
  },
  // Off by default. Each new finding arrives as a card photo; empty days send nothing.
  // notifications: {
  //   telegram: { enabled: true, credentials: { botToken: "${TELEGRAM_BOT_TOKEN}", chatId: "123456789" } },
  // },
}
